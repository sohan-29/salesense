# ── Backend environment ───────────────────────────────────────────────
# Copy to .env and fill in. Never commit the real .env.

# Server
PORT=5000
NODE_ENV=production

# Database — MongoDB Atlas (or a local Mongo for compose). Use the SRV form
# for Atlas: mongodb+srv://<user>:<pass>@<cluster>/shopsense?retryWrites=true&w=majority
MONGO_URI=mongodb://localhost:27017/shopsense

# Auth
JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRES_IN=7d

# Frontend origin (CORS). In docker-compose this is the served origin.
CLIENT_URL=http://localhost:8080
